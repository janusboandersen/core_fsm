{
  "version": 6,
  "configurePresets": [
    {
      "name": "host-debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../../build-host",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CORE_FSM_BUILD_TESTS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "host-debug", 
      "configurePreset": "host-debug",
      "verbose": true,
      "nativeToolOptions": ["-v"] 
    }
  ],
  "testPresets": [
    {
      "name": "host-debug",
      "configurePreset": "host-debug",
      "output": { "outputOnFailure": true }
    }
  ],
  "workflowPresets": [
    {
      "name": "host",
      "steps": [
        { "type": "configure", "name": "host-debug" },
        { "type": "build",     "name": "host-debug" },
        { "type": "test",      "name": "host-debug" }
      ]
    }
  ]
}